# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local source reference material (product brief, mood images) — kept on
# disk, not shipped with the repo. Delete from disk once the project ships.
*.JPG
SKIN AURA TEST.docx
SKIN AURA TEST.pdf

# editor / tooling clutter
.claude/
.superpowers/
tmp/
